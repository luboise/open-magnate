{
	"name": "backend",
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"build": "ts-node ./esbuild.mjs",
		"start": "node dist/index.js",
		"migrate": "prisma migrate db",
		"migrate-dev": "prisma migrate dev",
		"dev": "cp ./.env.dev ./.env && nodemon",
		"seed:dev": "prisma db seed",
		"test:integration:setup:docker": "docker compose up --force-recreate -d && npx wait-on tcp:localhost:3307",
		"test:integration:teardown": "docker compose down",
		"test:integration:setup:db": "prisma migrate deploy && prisma db seed",
		"test:integration:run": "jest -i --runInBand",
		"test:integration": "pnpm run test:integration:setup:docker && pnpm run test:integration:setup:db && pnpm run test:integration:run",
		"test:unit": "jest -c jest.config.unit.ts --watch"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"description": "",
	"dependencies": {
		"@dotenvx/dotenvx": "~1.12.1",
		"@prisma/adapter-mariadb": "~7.0.0",
		"@prisma/client": "~7.0.0",
		"class-validator": "~0.14.1",
		"cors": "~2.8.5",
		"crypto-js": "~4.2.0",
		"crypto-random-string": "~5.0.0",
		"express": "~5.1.0",
		"express-ws": "~5.0.2",
		"magnate-core": "workspace:*",
		"reflect-metadata": "~0.2.2",
		"sqlite3": "~5.1.7"
	},
	"devDependencies": {
		"@types/cors": "~2.8.17",
		"@types/express": "~5.0.5",
		"@types/express-ws": "~3.0.6",
		"@types/jest": "~29.5.12",
		"esbuild": "~0.21.5",
		"jest": "~29.7.0",
		"nodemon": "~3.1.3",
		"prisma": "~7.0.0",
		"ts-jest": "~29.1.5",
		"ts-node": "~10.9.2",
		"typescript": "~5.4.5",
		"wait-on": "~7.2.0"
	},
	"prisma": {
		"seed": "ts-node src/database/seeding/seed.ts"
	}
}
