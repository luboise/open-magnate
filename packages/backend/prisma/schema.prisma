// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider  = "prisma-client"
    output    = "../src/database/datasource/generated/"
    transpite = true
}

datasource db {
    provider = "mysql"
}

model UserSession {
    sessionKey  String       @id @unique @default(uuid())
    browserId   String       @unique
    name        String       @default("")
    lobbyPlayer LobbyPlayer?

    @@map("user_session")
}

model LobbyPlayer {
    isHost Boolean @default(false)

    // The lobby that the player is in
    lobby   Lobby @relation(fields: [lobbyId], references: [id], onDelete: Cascade)
    lobbyId Int

    // The user session of the player
    userSession UserSession @relation(fields: [userId], references: [sessionKey])
    userId      String      @unique

    timeJoined DateTime @default(now()) @db.Timestamp(3)

    // Which player they are in the match
    playerIndex Int

    @@map("lobby_player")
}

model Lobby {
    id       Int     @id @default(autoincrement()) @map("lobby_id")
    name     String
    password String?

    playersInLobby LobbyPlayer[]

    inviteCode String

    gameState Json

    lobbyStatus LOBBY_STATUS @default(PRE_LOBBY)

    @@map("lobby")
}

enum LOBBY_STATUS {
    PRE_LOBBY
    IN_GAME
    POST_LOBBY
}
