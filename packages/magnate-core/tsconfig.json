{
	"compilerOptions": {

		"target": "ES2021",
		"useDefineForClassFields": true,
		"lib": ["ES2021", "DOM", "DOM.Iterable"],
		"baseUrl": "./",
		"module": "ESNext",
		"skipLibCheck": true,
		"outDir": "dist",
		"rootDir": "src",
		"declaration": true,

		/* Bundler mode */
		"moduleResolution": "bundler",

		"noEmit": false,
		// "allowImportingTsExtensions": true,

		"resolveJsonModule": true,

		/* Linting */
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,

		// Source map for debugging
		"sourceMap": true,
		"composite": true,

		"paths": {
			"@/*": ["src/*"],
			"*": [
				"src/*",
				"node_modules/*"
			]
		}
	},
	"include": [
		"src/**/*"
	],
}

