{
	"compilerOptions": {
		"target": "ES2022",
		"useDefineForClassFields": true,
		// "lib": ["ES2021", "DOM", "DOM.Iterable"],
		"baseUrl": "./",
		"skipLibCheck": true,
		"outDir": "dist",
		"rootDir": "src",
		"declaration": true,

		"moduleResolution": "bundler",

		/* Bundler mode */

		"noEmit": false,
		// "allowImportingTsExtensions": true,

		/* Linting */
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,

		// Source map for debugging
		"sourceMap": true,
		"composite": true,

		"paths": {
			"*": [
				"src/*",
				"node_modules/*"
			],
			"@/*": ["src/*"]
		}
	},
	"include": [
		"src/**/*"
	],
}

